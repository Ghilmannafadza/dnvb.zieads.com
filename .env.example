# ============================================================
# dnvb.zieads.com (DNVB TikTok Hub): environment variables
# Copy to .env for local dev (npm run dev), and set the same in Vercel > Settings > Environment Variables.
# ============================================================

# ─── Supabase (NEW project for DNVB, run supabase/dnvb-setup.sql once) ───
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ───
# Public URL of this deployment. TikTok redirect URI = {OAUTH_REDIRECT_BASE_URL}/api/auth/tiktok/callback
OAUTH_REDIRECT_BASE_URL=https://dnvb.zieads.com
PUBLIC_APP_URL=https://dnvb.zieads.com
APP_URL=https://dnvb.zieads.com
# Exactly 64 hex characters (openssl rand -hex 32). Encrypts every TikTok token at rest. Never change it after accounts are connected.
ENCRYPTION_KEY=
# 16+ random characters. Vercel Cron sends it; also use it for an external every-minute scheduler (docs/scheduler.md)
CRON_SECRET=

# ─── TikTok (the only connector) ───
# developers.tiktok.com > your app > Login Kit + Content Posting API
# Redirect URI: https://dnvb.zieads.com/api/auth/tiktok/callback
# Webhooks (optional): /api/auth/tiktok/deauthorize and /api/auth/tiktok/data-deletion
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Scopes asked at sign in. Add video.upload (inbox drafts) and video.publish (Direct Post) once approved.
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
# Optional: override the TikTok account limit of every plan (-1 = unlimited)
DNVB_MAX_TIKTOK_ACCOUNTS=

# ─── Media uploads (videos for TikTok) ───
BLOB_READ_WRITE_TOKEN=

# ─── AI (Zie: AI Analyst, AI Agent, briefings). Sumopod is OpenAI compatible, key starts with sk- ───
SUMOPOD_API_KEY=
SUMOPOD_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Competitor Hunt (TikTok Ads library) ───
TIKTOK_ADLIB_ENABLED=
TIKTOK_ADLIB_REGIONS=ID
SCRAPECREATORS_API_KEY=

# ─── Email (optional) ───
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── Payments (optional, Dodo) ───
DODO_PAYMENTS_SECRET_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
VITE_DODO_PAYMENTS_PUBLISHABLE_KEY=

# ─── Superadmin (optional) ───
SUPERADMIN_IP_ALLOWLIST=
