{
  "functions": {
    "api/**": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v3/publish/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v3/jobs/run",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v3/monitor/tick",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/tiktok/cron/refresh-tokens",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/tiktok/cron/sync",
      "schedule": "45 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/oauth/bluesky/(.*)",
      "destination": "/api"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/data-deletion",
      "destination": "/data-deletion/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/analyst",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/agent",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
